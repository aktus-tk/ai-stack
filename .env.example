# ai-stack 共通の環境変数雛形
# 各ノードの ~/.envrc (direnv) や ~/.bashrc に実値を置く。このファイルは雛形のみ。

# --- クライアント (opencode) ---
# LiteLLM 仮想キー (LiteLLM UI で発行)
LITELLM_API_KEY=sk-REPLACE

# --- サーバー (harness-mem daemon) ---
# systemd unit / MCP クライアントで使用
HARNESS_MEM_HOST=100.92.131.75
HARNESS_MEM_PORT=37888
HARNESS_MEM_ADMIN_TOKEN=REPLACE_WITH_SERVER_TOKEN

# --- サーバー (LiteLLM Docker .env) ---
LITELLM_MASTER_KEY=REPLACE_WITH_LONG_RANDOM
LITELLM_SALT_KEY=REPLACE_WITH_LONG_RANDOM
UI_PASSWORD=REPLACE_WITH_PASSWORD
