# ai-stack 環境変数雛形
# 実値は ~/github/aktus-tk/ai-stack/.env に置く (.gitignore 済み)。
# cp .env.example .env して各値を設定すること。

# --- compose.yaml 共通 ---

# LiteLLM 仮想キー (opencode から litellm への接続に使用)
LITELLM_API_KEY=sk-REPLACE

# harness-mem daemon の認証トークン (長いランダム値)
HARNESS_MEM_ADMIN_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN

# harness-mem working daemon (harness-memd-working) の認証トークン。
# main とは別の値を設定する。
HARNESS_MEM_WORKING_ADMIN_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN

# LiteLLM イメージタグ (既定: latest。移行後はリリースタグに固定推奨)
LITELLM_IMAGE_TAG=latest

# --- postgres (litellm 用) ---
# 既存 litellm compose の POSTGRES_PASSWORD (litellm) と揃えること
POSTGRES_PASSWORD=litellm

# --- litellm (master key / UI) ---
LITELLM_MASTER_KEY=REPLACE_WITH_LONG_RANDOM
LITELLM_SALT_KEY=REPLACE_WITH_LONG_RANDOM
UI_USERNAME=admin
UI_PASSWORD=REPLACE_WITH_PASSWORD

# --- caddy (Tailscale 経由の入口) ---
# バインド先 IP (Tailscale IP のみ。public には公開しない)
CADDY_BIND_IP=100.92.131.75
# 外部から見えるポート
CADDY_PORT=8090
# basic auth ユーザー
CADDY_BASIC_AUTH_USER=opencode
# basic auth ハッシュ (caddy hash-password で生成した bcrypt ハッシュ)
#   docker run --rm caddy:2 caddy hash-password --plaintext '<password>'
CADDY_BASIC_AUTH_HASH=REPLACE_WITH_BCRYPT_HASH

# --- クライアント (CLI wrapper が参照) ---
# wrapper は compose.yaml の opencode service を使うため環境変数は不要。
# 旧方式 (.envrc / systemd) から移行完了後は削除。
