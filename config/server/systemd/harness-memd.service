# harness-memd.service
# サーバー (/etc/systemd/system/harness-memd.service) に配置する。
# 実環境では必ず HARNESS_MEM_HOST / HARNESS_MEM_ADMIN_TOKEN を実値に置き換えること。
#
#   sudo cp config/server/systemd/harness-memd.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now harness-memd

[Unit]
Description=Harness Memory Daemon
After=network.target tailscaled.service

[Service]
Type=forking
User=tk
WorkingDirectory=/home/tk

Environment="HOME=/home/tk"
Environment="BUN_INSTALL=/home/tk/.bun"
Environment="PATH=/home/tk/.bun/bin:/home/tk/.volta/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
# bind 先はサーバーの Tailscale IP
Environment="HARNESS_MEM_HOST=100.92.131.75"
# リモートバインドに必須の認証トークン (必ず長いランダム値に変更)
Environment="HARNESS_MEM_ADMIN_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN"

ExecStartPre=/bin/rm -f /run/harness-memd.pid
ExecStart=/home/tk/.volta/bin/harness-memd start
ExecStop=/home/tk/.volta/bin/harness-memd stop

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
